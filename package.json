{
  "name": "singularity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "postinstall": "node scripts/fix-pty-helper.mjs",
    "bootstrap": "node --env-file-if-exists=.env scripts/bootstrap.mjs",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config web/vite.config.mjs",
    "build": "node scripts/reap-build-orphans.mjs && vite build --config web/vite.config.mjs",
    "clean": "node scripts/reap-build-orphans.mjs",
    "dev": "concurrently -k \"npm:server\" \"npm:web\"",
    "start": "npm run build && npm run server",
    "ollama-login": "node --env-file-if-exists=.env scripts/ollama-login.mjs",
    "lint": "eslint .",
    "test": "node --test --test-force-exit \"server/*.test.mjs\" \"web/src/**/*.test.mjs\"",
    "test:e2e": "vite build --config web/vite.config.mjs && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev-mock": "vite --config web/vite.config.mjs --mode mock",
    "build:mock": "vite build --config web/vite.config.mjs --mode mock",
    "test:e2e-mock": "vite build --config web/vite.config.mjs --mode mock && playwright test --config playwright.mock.config.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fastify/static": "^10.1.2",
    "@iarna/toml": "^2.2.5",
    "@mui/icons-material": "^9.3.0",
    "@mui/material": "^9.3.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@zapac/mui-theme": "file:vendor\\zapac-mui-theme-0.2.0.tgz",
    "cron-parser": "^5.7.0",
    "cronstrue": "^3.24.0",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "fastify": "^5.11.2",
    "framer-motion": "^12.43.0",
    "mermaid": "^11.16.1",
    "node-pty": "^1.1.0",
    "phosphor-console-theme": "file:vendor\\phosphor-console-theme-0.1.0.tgz",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "miragejs": "^0.1.48",
    "mock-socket": "^9.3.1",
    "vite": "^6.4.3"
  }
}
